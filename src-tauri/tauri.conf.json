{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Komodash",
  "version": "0.1.1",
  "identifier": "com.komodash.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Komodash",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "dazu5",
    "category": "Utility",
    "shortDescription": "Dashboard for Komorebi tiling window manager",
    "longDescription": "Komodash is a GUI for editing Komorebi's static configuration, bar configuration, whkd hotkeys, and application rules — with a live state view of your tiled windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
